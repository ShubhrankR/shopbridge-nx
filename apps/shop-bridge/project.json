{
    "name": "shop-bridge",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "prefix": "thinkbridge",
    "sourceRoot": "apps/shop-bridge/src",
    "targets": {
        "build": {
            "executor": "@angular-devkit/build-angular:browser",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/shop-bridge",
                "index": "apps/shop-bridge/src/index.html",
                "main": "apps/shop-bridge/src/main.ts",
                "polyfills": "apps/shop-bridge/src/polyfills.ts",
                "tsConfig": "apps/shop-bridge/tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "assets": [
                    "apps/shop-bridge/src/favicon.ico",
                    "apps/shop-bridge/src/assets"
                ],
                "styles": ["apps/shop-bridge/src/styles.scss"],
                "scripts": ["node_modules/tw-elements/dist/js/tw-elements.umd.min.js"]
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "1.5mb",
                            "maximumError": "2.5mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "4kb",
                            "maximumError": "8kb"
                        }
                    ],
                    "fileReplacements": [
                        {
                            "replace": "apps/shop-bridge/src/environments/environment.ts",
                            "with": "apps/shop-bridge/src/environments/environment.prod.ts"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "buildOptimizer": false,
                    "optimization": false,
                    "vendorChunk": true,
                    "extractLicenses": false,
                    "sourceMap": true,
                    "namedChunks": true
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "executor": "@angular-devkit/build-angular:dev-server",
            "configurations": {
                "production": {
                    "buildTarget": "shop-bridge:build:production"
                },
                "development": {
                    "buildTarget": "shop-bridge:build:development"
                }
            },
            "defaultConfiguration": "development",
            "options": {
                "proxyConfig": "apps/shop-bridge/proxy.conf.json"
            }
        },
        "extract-i18n": {
            "executor": "@angular-devkit/build-angular:extract-i18n",
            "options": {
                "buildTarget": "shop-bridge:build"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "options": {
                "lintFilePatterns": [
                    "apps/shop-bridge/src/**/*.ts",
                    "apps/shop-bridge/src/**/*.html"
                ]
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/apps/shop-bridge"],
            "options": {
                "jestConfig": "apps/shop-bridge/jest.config.js",
                "passWithNoTests": true
            }
        }
    },
    "tags": []
}
