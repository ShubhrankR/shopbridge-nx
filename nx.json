{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "npmScope": "thinkbridge",
    "defaultProject": "shop-bridge",
    "targetDefaults": {
        "build": {
            "cache": true,
            "dependsOn": ["^build"]
        },
        "test": {
            "cache": true
        },
        "lint": {
            "cache": true
        },
        "e2e": {
            "cache": true
        }
    },
    "generators": {
        "@nx/angular:application": {
            "style": "scss",
            "linter": "eslint",
            "unitTestRunner": "jest",
            "e2eTestRunner": "cypress"
        },
        "@nx/angular:library": {
            "linter": "eslint",
            "unitTestRunner": "jest"
        },
        "@nx/angular:component": {
            "style": "scss"
        }
    }
}
